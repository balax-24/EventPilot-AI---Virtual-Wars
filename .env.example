# ==============================================================================
# EventPilot AI - Environment Configuration Example
# Copy this file to .env.local and populate with your actual credentials.
# NEVER commit .env.local or real API keys to version control.
# ==============================================================================

# Generative AI Provider: Google Gemini
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Configuration (defaults to gemini-2.5-flash if omitted)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Supabase Database & Auth Persistence
# Obtain credentials from your Supabase project dashboard: https://supabase.com
# If omitted, EventPilot AI seamlessly operates with robust client-side persistence (IndexedDB / LocalStorage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
